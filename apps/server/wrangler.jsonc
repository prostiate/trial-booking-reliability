{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trial-booking-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "trial-booking-reliability.irfankurniawan.com/api/*",
      "zone_name": "irfankurniawan.com",
    },
  ],
  "vars": {
    "NODE_ENV": "production",
    "CORS_ORIGINS": "https://trial-booking-reliability.irfankurniawan.com,http://localhost:24002",
  },
  "observability": {
    "enabled": true,
  },
}
