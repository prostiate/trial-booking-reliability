{
  "name": "trial-booking-reliability",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint && pnpm lint:node",
    "lint:node": "eslint apps/server packages",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck",
    "ci:check": "pnpm verify && pnpm test",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "deploy:server": "pnpm --filter @trial-booking/server exec wrangler deploy",
    "deploy:dashboard": "pnpm --filter @trial-booking/dashboard build && pnpm --filter @trial-booking/dashboard exec wrangler deploy",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.0"
  },
  "packageManager": "pnpm@11.18.0"
}
